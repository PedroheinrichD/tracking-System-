# Copie este arquivo para .env.local e preencha os valores.

# ── Banco de dados (MySQL 8+ ou MariaDB 10.4+) ─────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sob_medida_ats

# ── Inteligência artificial (Anthropic Claude) ─────────────────────────────
# Crie uma chave em https://platform.claude.com e cole aqui. Nunca exponha no front-end.
ANTHROPIC_API_KEY=
# Modelo usado em todas as etapas. Padrão: claude-opus-5-5
AI_MODEL=claude-opus-5-5

# ── Armazenamento dos arquivos enviados (fica fora da pasta public) ────────
STORAGE_DIR=./storage

# ── Contas ─────────────────────────────────────────────────────────────────
# false: só é possível criar a primeira conta (uso pessoal). true: cadastro aberto.
ALLOW_REGISTRATION=false
# Validade da sessão, em dias.
SESSION_TTL_DAYS=30
